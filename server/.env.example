PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/nexora
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# Gmail SMTP. Use an App Password from the Google account that sends the mail.
# Login and reset codes are delivered to the email address on the Nexora account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Agora Console: project App ID and primary certificate. The certificate stays on the server.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Chat data center 61. REST is a61. The browser SDK socket is resolved from that data center.
AGORA_CHAT_REST_HOST=https://a61.chat.agora.io
AGORA_CHAT_WS_HOST=https://msync-api-61.chat.agora.io
# Optional. Leave empty to use the App Key Agora returns for this App ID.
AGORA_CHAT_APP_KEY=
