DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER/nexora_platform?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30
PORT=4000
CLIENT_ORIGINS=http://localhost:3000,http://localhost:5173

# Gmail SMTP. Use an App Password from the Google account that sends the mail.
# Login codes are delivered to the email address on the Nexora account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
